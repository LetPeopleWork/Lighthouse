<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<SelfContained>true</SelfContained>
    	<UseAppHost>true</UseAppHost>
		<AssemblyName>Lighthouse</AssemblyName>
		<PublishSingleFile>true</PublishSingleFile>
		<UserSecretsId>d41c4b41-bba9-4819-950c-78f93d0e54ba</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<PropertyGroup>
		<Version>$(Version)</Version>
		<FileVersion>$(Version)</FileVersion>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<ApplicationIcon>favicon.ico</ApplicationIcon>
	</PropertyGroup>

    <ItemGroup>
	  <AdditionalFiles Include="BannedSymbols.txt" />
	</ItemGroup>

    <ItemGroup>
	  <None Remove="certs\LighthouseDefaultCert.pfx" />
	  <None Remove="Modules\Licensing\Application\public_key.pem" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="34.0.0" />
		<PackageReference Include="GraphQL.Client" Version="6.1.0" />
		<PackageReference Include="GraphQL.Client.Serializer.Newtonsoft" Version="6.1.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="11.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="11.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="11.0.0" />
		<!-- Microsoft.TeamFoundationServer.Client floors this at 6.0.1 while Microsoft.Data.SqlClient needs 8.0.0 or later; a direct reference settles the conflict. -->
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="11.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.TeamFoundationServer.Client" Version="20.256.2" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
		<PackageReference Include="Octokit" Version="14.0.0" />
		<PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Expressions" Version="5.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="StackExchange.Redis" Version="3.4.35" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
		<PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
	</ItemGroup>


	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Lighthouse.Backend.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>


	<ItemGroup>
	  <Content Include="favicon.ico" />
	</ItemGroup>


	<ItemGroup>
	  <EmbeddedResource Include="Modules\Licensing\Application\public_key.pem" />
	</ItemGroup>


	<ItemGroup>
	  <Reference Include="Lighthouse.Migrations.Postgres">
	    <HintPath>..\Migrations\Lighthouse.Migrations.Postgres.dll</HintPath>
	    <Private>True</Private>
	  </Reference>
	  <Reference Include="Lighthouse.Migrations.Sqlite">
	    <HintPath>..\Migrations\Lighthouse.Migrations.Sqlite.dll</HintPath>
	    <Private>True</Private>
	  </Reference>
	</ItemGroup>


	<ItemGroup>
  	<PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
  	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
  	  <PrivateAssets>all</PrivateAssets>
  	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
  	</PackageReference>
	<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
	  <None Update="certs\LighthouseCert.pfx">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Factories\DemoData\Project NeuroLink City.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Factories\DemoData\Project Ocean Explorer.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Factories\DemoData\Project Altobelli.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Factories\DemoData\Project Orion.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Factories\DemoData\Project Apollo.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Factories\DemoData\Team Lightspeed.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Factories\DemoData\Team Meridian.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Factories\DemoData\Team Equinox.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Factories\DemoData\Team Gravity.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Factories\DemoData\Team Voyager.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Factories\DemoData\Team Pulsar.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Factories\DemoData\Team Zenith.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>


</Project>
