{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.baseview.ts" },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "off",
  "concurrency": 1,
  "timeoutMS": 180000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": ["dist", "coverage", "playwright-report", "reports"],
  "mutate": ["src/pages/Common/MetricsView/BaseMetricsView.tsx:1225-1240"],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "jsonReporter": { "fileName": "stryker-5915-baseview.json" },
  "tempDirName": ".stryker-tmp-5915-baseview"
}
