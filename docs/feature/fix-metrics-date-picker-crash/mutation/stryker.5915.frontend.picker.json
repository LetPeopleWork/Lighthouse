{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.picker.ts" },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "off",
  "concurrency": 1,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": ["dist", "coverage", "playwright-report", "reports"],
  "mutate": [
    "src/utils/date/isValidDate.ts",
    "src/utils/date/localDate.ts",
    "src/components/Common/DateRangeSelector/DateRangeSelector.tsx",
    "src/pages/Common/MetricsView/DashboardHeader.tsx:51-54",
    "src/pages/Common/MetricsView/DashboardHeader.tsx:141-142"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "jsonReporter": { "fileName": "stryker-5915-picker.json" },
  "tempDirName": ".stryker-tmp-5915-picker"
}
