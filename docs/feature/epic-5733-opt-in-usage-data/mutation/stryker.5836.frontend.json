{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.mutation.ts" },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": ["dist", "coverage", "playwright-report", "reports"],
  "mutate": [
    "src/services/UsageData/usageDataAdminVetoCopy.ts",
    "src/components/UsageData/UsageDataIndicator.tsx:36-60",
    "src/components/UsageData/UsageDataDialog.tsx:118-152",
    "src/hooks/useUsageDataConsent.tsx:110-135"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "jsonReporter": { "fileName": "stryker-5836-frontend.json" },
  "tempDirName": ".stryker-tmp-5836"
}
