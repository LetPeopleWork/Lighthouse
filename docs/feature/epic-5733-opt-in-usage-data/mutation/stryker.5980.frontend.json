{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.mutation.ts" },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": ["dist", "coverage", "playwright-report", "reports"],
  "mutate": [
    "src/services/UsageData/usageDataEvents.ts",
    "src/services/UsageData/usageDataRouteKeys.ts",
    "src/services/UsageData/usageDataBuffer.ts",
    "src/hooks/useUsageDataConsent.tsx",
    "src/services/Api/UsageDataService.ts",
    "src/models/UsageData/UsageData.ts"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "jsonReporter": { "fileName": "stryker-5980-frontend.json" },
  "tempDirName": ".stryker-tmp-5980"
}
