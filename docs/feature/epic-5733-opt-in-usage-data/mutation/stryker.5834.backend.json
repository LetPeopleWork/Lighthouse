{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/UsageData/UsageDataConsentService.cs",
      "**/Services/Implementation/Repositories/UsageDataConsentRepository.cs",
      "**/API/UsageDataController.cs",
      "**/Extensions/UrlSafeValue.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "FullyQualifiedName~UsageData|FullyQualifiedName~AppSettingService",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
