{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/UsageData/UsageDataGate.cs",
      "**/Services/Implementation/UsageData/PostHogUsageDataPublisher.cs",
      "**/Services/Implementation/UsageData/UsageDataInstanceProperties.cs",
      "**/Services/Implementation/UsageData/UsageDataDeploymentModeResolver.cs",
      "**/Services/Implementation/UsageData/UsageDataEventQueue.cs",
      "**/Services/Implementation/UsageData/UsageDataConsentToken.cs",
      "**/Services/Implementation/UsageData/UsageDataConsentService.cs",
      "**/Services/Implementation/BackgroundServices/UsageDataForwardingService.cs",
      "**/Models/UsageData/UsageDataRoutePatterns.cs",
      "**/API/UsageDataController.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "FullyQualifiedName~UsageData",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
