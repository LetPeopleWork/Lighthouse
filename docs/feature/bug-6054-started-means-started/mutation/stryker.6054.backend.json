{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Models/Feature.cs",
      "**/Services/Implementation/WriteBackTriggerService.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~FeatureTest|FullyQualifiedName~FeatureWhenWorkBeginsTest|FullyQualifiedName~FeatureUnknownForecastTest|FullyQualifiedName~FeatureMissingForecastRowTest|FullyQualifiedName~FeatureComparerTest|FullyQualifiedName~FeatureDependencyReferenceTest|FullyQualifiedName~DeliveryFeatureSizeTest|FullyQualifiedName~DeliveryJointForecastTest|FullyQualifiedName~DeliveryForecastPublishingInvariantTest|FullyQualifiedName~FeatureDtoTest|FullyQualifiedName~FeatureDtoStartForecastTest|FullyQualifiedName~FeatureStartDtoTest|FullyQualifiedName~WriteBackTriggerServiceTest|FullyQualifiedName~WriteBackMappingValidatorTest|FullyQualifiedName~WriteBackServiceTest|FullyQualifiedName~WriteBackCollectorTest|FullyQualifiedName~WriteBackSuppressionWarningTest|FullyQualifiedName~BlackoutForecastShiftWriteBackTest|FullyQualifiedName~ForecastServiceStartDayTest)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Integration.Containers",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 60000,
    "verbosity": "info"
  }
}
