{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "vitest.stryker.5876-slice-02.config.ts"
  },
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": [
    "dist",
    "coverage",
    "playwright-report",
    "reports"
  ],
  "mutate": [
    "src/services/Terminology/resolveTerms.ts",
    "src/services/TerminologyContext.tsx",
    "src/services/Api/OptionalFeatureService.ts",
    "src/pages/Settings/System/BehaviourSettingsTable.tsx",
    "src/pages/Settings/System/SystemSettingsTab.tsx",
    "src/hooks/useFeatureOrdering.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 0
  },
  "jsonReporter": {
    "fileName": "stryker-5876-slice-02-frontend.json"
  },
  "tempDirName": ".stryker-tmp-5876-slice-02"
}
