{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.pbc-baseline.config.ts" },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": ["/dist", "/coverage", "/playwright-report", "/reports"],
  "mutate": [
    "src/components/Common/BaseSettings/FlowMetricsConfigurationComponent.tsx:725-725"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "jsonReporter": { "fileName": "/tmp/claude-1000/stryker-pbc-baseline-frontend.json" },
  "tempDirName": ".stryker-tmp-pbc-baseline"
}
