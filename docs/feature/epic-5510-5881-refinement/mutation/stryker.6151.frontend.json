{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "vitest.stryker.6151.ts",
    "related": false
  },
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": [
    "dist",
    "coverage",
    "playwright-report",
    "reports"
  ],
  "mutate": [
    "src/components/Common/Team/RefinementSettingsSection.tsx:30-160",
    "src/components/Common/Team/RefinementSettingsSection.tsx:212-246",
    "src/components/Common/Team/RefinementSettingsSection.tsx:260-300",
    "src/components/Common/Team/ModifyTeamSettings.tsx:87-90",
    "src/components/Common/Team/ModifyTeamSettings.tsx:270-284",
    "src/pages/Teams/Detail/Refinement/ReadinessCell.tsx",
    "src/pages/Teams/Detail/Refinement/useVoteCasting.ts:70-75",
    "src/pages/Teams/Detail/Refinement/voteWording.ts:52-65",
    "src/pages/Teams/Detail/Refinement/refinementColumns.tsx:71-81",
    "src/pages/Teams/Detail/Refinement/RefinementView.tsx:31-58",
    "src/pages/Teams/Detail/Refinement/RefinementView.tsx:102-102",
    "src/pages/Teams/Detail/Refinement/RefinementView.tsx:161-169"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 0
  },
  "jsonReporter": {
    "fileName": "stryker-6151-frontend.json"
  },
  "tempDirName": ".stryker-tmp-6151"
}
