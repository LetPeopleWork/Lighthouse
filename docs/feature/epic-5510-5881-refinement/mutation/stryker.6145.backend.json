{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/API/DTO/RefinementSettingsDto.cs",
      "**/API/Helpers/RefinementSettingsValidator.cs",
      "**/API/Helpers/TeamExtensions.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Tests.API.Helpers|FullyQualifiedName~Tests.Models.Refinement|FullyQualifiedName~Tests.API.DTO|FullyQualifiedName~TeamControllerTest|FullyQualifiedName~TeamsControllerTest)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Integration.Containers&FullyQualifiedName!~ArchUnit",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
