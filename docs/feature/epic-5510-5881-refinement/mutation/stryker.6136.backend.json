{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/API/Helpers/RefinementSettingsValidator.cs",
      "**/API/RefinementController.cs",
      "**/API/DTO/RefinementViewDto.cs",
      "**/API/DTO/RefinementSettingsDto.cs",
      "**/Services/Implementation/Refinement/RefinementList.cs",
      "**/Services/Implementation/Refinement/RefinementViewQuery.cs",
      "**/Models/Refinement/RefinementSettings.cs",
      "**/API/Helpers/TeamExtensions.cs",
      "**/Factories/DemoDataFactory.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Refinement|FullyQualifiedName~StateMappingSyncTest|FullyQualifiedName~BaselineSettingsSyncTest|FullyQualifiedName~BlockedRuleSetSyncTest|FullyQualifiedName~EstimationFieldSyncTest|FullyQualifiedName~DemoDataFactoryTest|FullyQualifiedName~TeamControllerTest|FullyQualifiedName~TeamsController)&FullyQualifiedName!~Containers",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 60000,
    "verbosity": "info"
  }
}
