    "src/pages/Teams/Detail/Refinement/useCommentAdding.ts",
    "src/pages/Teams/Detail/Refinement/useNameFirst.ts",
    "src/pages/Teams/Detail/Refinement/useSizingLog.ts",
    "src/pages/Teams/Detail/Refinement/useVoteCasting.ts:18-30",
    "src/pages/Teams/Detail/Refinement/useVoteCasting.ts:57-61",
    "src/pages/Teams/Detail/Refinement/useVoteCasting.ts:80-94",
    "src/pages/Teams/Detail/Refinement/useVoteCasting.ts:129-169",
    "src/pages/Teams/Detail/Refinement/voteWording.ts:19-22",
    "src/pages/Teams/Detail/Refinement/voteWording.ts:38-43",
