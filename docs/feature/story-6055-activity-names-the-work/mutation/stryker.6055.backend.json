{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "../Lighthouse.Backend.Tests/Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/API/UpdateController.cs",
      "**/Services/Implementation/BackgroundServices/Update/UpdateEntityKinds.cs",
      "**/Services/Implementation/BackgroundServices/Update/UpdateTaskNaming.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "FullyQualifiedName~TaskManager|FullyQualifiedName~UpdateControllerTest",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 120000,
    "verbosity": "info"
  }
}
