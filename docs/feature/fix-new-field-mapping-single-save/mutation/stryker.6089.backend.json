{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/API/Helpers/NewAdditionalFieldTargets.cs",
      "**/API/Helpers/WriteBackMappingValidator.cs",
      "**/API/WorkTrackingSystemConnectionController.cs",
      "**/API/WorkTrackingSystemConnectionsController.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~WorkTrackingSystemConnection|FullyQualifiedName~WriteBackMapping)&FullyQualifiedName!~IntegrationTest",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
