{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.mutation.ts" },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "timeoutMS": 120000,
  "timeoutFactor": 3,
  "dryRunTimeoutMinutes": 30,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": ["/dist", "/coverage", "/playwright-report", "/reports"],
  "mutate": ["src/tests/timeBudget/timeBudgetOptions.ts"],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "jsonReporter": { "fileName": "reports/mutation/stryker-6513-frontend.json" },
  "tempDirName": ".stryker-tmp-6513"
}
