{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "vitest.stryker.5843.ts"
  },
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": [
    "dist",
    "coverage",
    "playwright-report",
    "reports"
  ],
  "mutate": [
    "src/components/App/Header/TaskManager/RecentProblemsSection.tsx"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 0
  },
  "jsonReporter": {
    "fileName": "stryker-5843-frontend.json"
  },
  "tempDirName": ".stryker-tmp-5843"
}
