{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/API/UpdateController.cs",
      "**/Services/Implementation/BackgroundServices/Update/InProcessUpdateStatusStore.cs",
      "**/Services/Implementation/BackgroundServices/Update/UpdateMoments.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~TaskManager|FullyQualifiedName~UpdateController|FullyQualifiedName~BackgroundServices.Update)&FullyQualifiedName!~MultiReplica&FullyQualifiedName!~ContainerTests",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
