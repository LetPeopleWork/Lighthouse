{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Models/Staleness/StalenessPolicy.cs",
      "**/Models/Staleness/StalenessVerdict.cs",
      "**/Models/Staleness/StaleReasonKind.cs",
      "**/API/DTO/StaleReasonDto.cs",
      "**/API/DTO/WorkItemDto.cs",
      "**/Services/Implementation/WorkItems/WorkItemService.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~StalenessPolicyTest|FullyQualifiedName~WorkItemDtoTests|FullyQualifiedName~FeatureDtoTest|FullyQualifiedName~TeamMetricsControllerTest|FullyQualifiedName~PortfolioMetricsControllerTests|FullyQualifiedName~WorkItemServiceTest)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Tests.Integration&FullyQualifiedName!~Acceptance&FullyQualifiedName!~Dogfood",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
