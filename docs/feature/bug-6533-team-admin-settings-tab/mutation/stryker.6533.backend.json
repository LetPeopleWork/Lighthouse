{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/API/DTO/WorkTrackingSystemConnectionSummaryDto.cs",
      "**/API/PortfolioController.cs",
      "**/API/Helpers/PortfolioExtensions.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~S2_ConnectionListPayloadShapeTests|FullyQualifiedName~PortfolioControllerTest|FullyQualifiedName~PortfolioExtensionsTest)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Dogfood",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
