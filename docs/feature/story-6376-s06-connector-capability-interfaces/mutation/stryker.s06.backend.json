{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Modules/WorkItems/Application/WorkItemService.cs",
      "**/Services/Implementation/WriteBackService.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~WorkItemServiceTest|FullyQualifiedName~RefreshesStayTheSameTest|FullyQualifiedName~WriteBackServiceTest|FullyQualifiedName~CapabilityTest|FullyQualifiedName~CapabilityArchUnitTest)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Dogfood",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
