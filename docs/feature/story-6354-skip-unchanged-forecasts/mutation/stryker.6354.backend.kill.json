{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Services/Implementation/WriteBackRound.cs",
      "**/Services/Implementation/Repositories/PortfolioRepository.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~WriteBackRound|FullyQualifiedName~RefreshRoundSummary|FullyQualifiedName~Tests.Services.Implementation.Repositories.PortfolioRepositoryTest|FullyQualifiedName~ForecastConfirmationRepositoryRelationalTest|FullyQualifiedName~ForecastInputsForgottenAtStartSeeder|FullyQualifiedName~Tests.Services.Implementation.BackgroundServices.Update.)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Dogfood&FullyQualifiedName!~Integration.Containers&FullyQualifiedName!~IntegrationTest&TestCategory!=Integration&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
