{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/API/DTO/ConnectionDefaultsDto.cs",
      "**/API/Helpers/NewAdditionalFieldTargets.cs",
      "**/API/Helpers/PortfolioExtensions.cs",
      "**/API/Helpers/TeamExtensions.cs",
      "**/API/Helpers/TeamParentOverrideRefusals.cs",
      "**/API/TeamController.cs",
      "**/API/WorkTrackingSystemConnectionController.cs",
      "**/API/WorkTrackingSystemConnectionsController.cs",
      "**/Models/WorkTrackingSystemConnection.cs",
      "**/Models/WorkTrackingSystemOptionsOwner.cs",
      "**/Services/Implementation/Connections/ConnectionSaveService.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "FullyQualifiedName~Tests.API.TeamControllerTest|FullyQualifiedName~WorkTrackingSystemConnectionControllerTest|FullyQualifiedName~WorkTrackingSystemConnectionControllerWriteBackTest|FullyQualifiedName~WorkTrackingSystemConnectionsControllerTest|FullyQualifiedName~ConnectionSaveServiceTest|FullyQualifiedName~TeamExtensionsTest|FullyQualifiedName~EstimationFieldSyncTest|FullyQualifiedName~WorkTrackingSystemOptionsOwnerTest|FullyQualifiedName~Tests.Models.WorkTrackingSystemConnectionTest",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
