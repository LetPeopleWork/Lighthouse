{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Models/Feature.cs",
      "**/Services/Implementation/RefreshLogService.cs",
      "**/Services/Implementation/WorkTrackingConnectors/Jira/IssueExtensions.cs",
      "**/Services/Implementation/WorkTrackingConnectors/Jira/JiraWorkTrackingConnector.cs",
      "**/Services/Implementation/WorkItems/WorkItemService.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "FullyQualifiedName~JiraNamedDependencyLinkTest|FullyQualifiedName~JiraDependencyLinkTest|FullyQualifiedName~Models.FeatureTest|FullyQualifiedName~RefreshLogServiceTest|FullyQualifiedName~WorkItemServiceTest",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
