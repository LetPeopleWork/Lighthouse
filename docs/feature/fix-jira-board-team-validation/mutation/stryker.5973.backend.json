{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/WorkTrackingConnectors/Jira/JiraWorkTrackingConnector.cs",
      "**/Services/Implementation/WorkTrackingConnectors/Jira/JiraQueryRejectedException.cs",
      "**/Services/Implementation/WorkTrackingConnectors/Jira/JiraReadException.cs"
    ],
    "ignore-methods": [
      "*Log*",
      "Console.*"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~JiraBoardQueryAssemblyTest|FullyQualifiedName~JiraIssuesPerRequestTest|FullyQualifiedName~JiraIncrementalSyncTest|FullyQualifiedName~JiraDependencyLinkTest|FullyQualifiedName~JiraQuietWriteBackTest|FullyQualifiedName~JiraBatchedWriteBackTest|FullyQualifiedName~JiraWorkTrackingConnectorAuthDelegationTest|FullyQualifiedName~JiraDeliverySourceProviderTest|FullyQualifiedName~JiraDeliveryForecastPublisherTest)&TestCategory!=JiraIntegration&TestCategory!=AdoIntegration&TestCategory!=LinearIntegration&TestCategory!=ServiceNowIntegration&TestCategory!=GithubIntegration&TestCategory!=Integration&TestCategory!=requires-docker&TestCategory!=real-io",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
