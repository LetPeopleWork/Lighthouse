{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Models/Feature.cs",
      "**/Models/Portfolio.cs",
      "**/API/Helpers/PortfolioExtensions.cs",
      "**/API/DTO/FeatureDto.cs",
      "**/API/DTO/FeatureListDto.cs",
      "**/API/DTO/PortfolioSettingDto.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Tests.Models.FeatureTest|FullyQualifiedName~Tests.Models.PortfolioTest|FullyQualifiedName~Tests.Modules.WorkItems.Application.DefaultFeatureSizing|FullyQualifiedName~FeatureHasNoChildWorkItemsYetTest|FullyQualifiedName~PortfolioSettingDtoCompatibilityTest|FullyQualifiedName~FeatureDtoTest|FullyQualifiedName~PortfolioExtensionsTest)&FullyQualifiedName!~Integration",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}