{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "vitest.stryker.mutation.ts"
  },
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": [
    "dist",
    "coverage",
    "playwright-report",
    "reports"
  ],
  "mutate": [
    "src/models/Delivery/DeliverySource.ts",
    "src/pages/Portfolios/Detail/Components/DeliveryGrid/DeliverySourceTab.tsx",
    "src/pages/Portfolios/Detail/Components/DeliveryGrid/deliverySelectionTabs.ts",
    "src/pages/Portfolios/Detail/Components/DeliveryGrid/DeliveryCreateModal.tsx:271-292",
    "src/pages/Portfolios/Detail/Components/DeliveryGrid/DeliveryCreateModal.tsx:335-353",
    "src/pages/Portfolios/Detail/Components/DeliveryGrid/DeliveryCreateModal.tsx:371-392",
    "src/pages/Portfolios/Detail/Components/DeliveryGrid/DeliveryCreateModal.tsx:444-459",
    "src/pages/Portfolios/Detail/Components/DeliveryGrid/DeliveryCreateModal.tsx:570-591",
    "src/services/Api/DeliveryService.ts:278-315"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 0
  },
  "jsonReporter": {
    "fileName": "stryker-5828-frontend.json"
  },
  "tempDirName": ".stryker-tmp-5828"
}
