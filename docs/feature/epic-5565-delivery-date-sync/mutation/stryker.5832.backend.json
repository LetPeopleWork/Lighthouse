{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "../Lighthouse.Backend.Tests/Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Models/Delivery.cs",
      "**/Services/Implementation/WorkTrackingConnectors/Jira/JiraReleaseVersionReader.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "off",
    "test-case-filter": "FullyQualifiedName~DeliveryPublishRefusalInvariantTest|FullyQualifiedName~DeliveryForecastPublishingInvariantTest|FullyQualifiedName~DeliverySourceBindingInvariantTest|FullyQualifiedName~DeliverySourceBindingPersistenceTest|FullyQualifiedName~DeliverySourceUnavailableInvariantTest|FullyQualifiedName~DeliverySourceSyncInvariantTest|FullyQualifiedName~DeliveryArchivedInvariantTest|FullyQualifiedName~DeliveryTest|FullyQualifiedName~DeliveryJointForecastTest|FullyQualifiedName~DeliveryFeatureSizeTest|FullyQualifiedName~DeliverySelectionModePersistedValueTest|FullyQualifiedName~JiraDeliverySourceProviderTest|FullyQualifiedName~JiraDeliveryForecastPublisherTest|FullyQualifiedName~DeliveryForecastPublishingServiceTest",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 1,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
