{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Services/Implementation/Reports/ThenAndNowTemplate.cs",
      "**/Services/Implementation/Reports/ReportWindowPolicy.cs",
      "**/Models/Reports/ThenAndNowPayload.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "ignore-methods": [
      "*Log*",
      "Console.*"
    ],
    "coverage-analysis": "perTest",
    "test-case-filter": "(FullyQualifiedName~Tests.Acceptance.BaselineReportCreation)|((FullyQualifiedName~Tests.Services.Implementation.Reports|FullyQualifiedName~Tests.Models.Reports)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Integration.Containers&FullyQualifiedName!~Dogfood&FullyQualifiedName!~Tests.Contracts&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration&TestCategory!=GithubIntegration)",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 2,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
