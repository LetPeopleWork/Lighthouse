{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/API/UsageDataController.cs",
      "**/API/DTO/UsageDataEventBatchDto.cs",
      "**/Services/Implementation/UsageData/UsageDataConsentService.cs",
      "**/Services/Implementation/UsageData/PostHogUsageDataPublisher.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Tests.Services.Implementation.UsageData|FullyQualifiedName~UsageDataControllerTests)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Integration.&FullyQualifiedName!~ArchUnit",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
