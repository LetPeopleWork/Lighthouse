{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/Reports/ReportBulkRemover.cs",
      "**/API/ReportsController.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Services.Implementation.Reports.ReportBulkRemoverTest|FullyQualifiedName~Tests.API.ReportsControllerTest|FullyQualifiedName~Slice05RemoveReportsInBulkScenarios)&FullyQualifiedName!~Integration.Containers&FullyQualifiedName!~Dogfood&TestCategory!=Integration&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
