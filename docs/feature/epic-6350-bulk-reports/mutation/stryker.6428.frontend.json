{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.6428.mutation.ts", "related": false },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": "reports/mutation/stryker-incremental-6428.json",
  "concurrency": 2,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": ["/dist", "/coverage", "/playwright-report", "/reports", "/StrykerOutput"],
  "mutate": [
    "src/pages/Reports/ReportsPage.tsx",
    "src/pages/Reports/useAllReports.ts",
    "src/pages/Reports/useAllReportsListedReporter.ts",
    "src/pages/Common/Reports/ReportList.tsx",
    "src/pages/Common/Reports/reportOwner.ts",
    "src/pages/Common/Reports/thenRebuildCopy.ts",
    "src/pages/Common/Reports/useMayEditReports.ts",
    "src/pages/Common/Reports/useReportDeletion.tsx",
    "src/pages/Common/Reports/useReportEditing.tsx",
    "src/pages/Common/Reports/useReportPdfExport.ts",
    "src/pages/Common/Reports/wizard/ReportWizard.tsx",
    "src/services/Api/ReportService.ts",
    "src/components/App/Header/Header.tsx",
    "src/components/Common/StyledLink/StyledLink.tsx"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "jsonReporter": { "fileName": "reports/mutation/stryker-6428-frontend.json" },
  "tempDirName": ".stryker-tmp-6428"
}
