{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Modules/TrackerIntegration/Domain/**/*.cs",
      "**/Modules/TrackerIntegration/Application/**/*.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Lighthouse.Backend.Tests.Modules.TrackerIntegration|FullyQualifiedName~Lighthouse.Backend.Tests.Modules.WorkItems)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Dogfood&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration&TestCategory!=GithubIntegration",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
