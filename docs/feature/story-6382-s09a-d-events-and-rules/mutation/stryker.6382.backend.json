{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Modules/Forecasting/Contracts/ForecastRoundFinished.cs",
      "**/Modules/Forecasting/Adapters/Background/ForecastUpdater.cs",
      "**/Modules/WorkItems/Application/Policies/ForecastRoundFinishedRefreshLogHandler.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~ForecastUpdaterTest|FullyQualifiedName~ForecastRoundsKeepTheirRefreshLogEntryTest|FullyQualifiedName~ForecastRoundFinished)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Dogfood",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
