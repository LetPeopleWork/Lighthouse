{
	"packageManager": "pnpm",
	"testRunner": "vitest",
	"plugins": ["@stryker-mutator/vitest-runner"],
	"vitest": {
		"configFile": "vitest.stryker.6425.ts"
	},
	"reporters": ["clear-text", "progress", "json"],
	"coverageAnalysis": "perTest",
	"concurrency": 2,
	"timeoutMS": 120000,
	"inPlace": true,
	"disableTypeChecks": false,
	"ignorePatterns": ["/dist", "/coverage", "/playwright-report", "/reports"],
	"mutate": [
		"src/utils/tauri.ts:9-10",
		"src/pages/Common/Reports/ReportList.tsx:51-64",
		"src/pages/Common/Reports/ThenAndNowHeader.tsx:44-51"
	],
	"thresholds": { "high": 90, "low": 80, "break": 0 },
	"jsonReporter": { "fileName": "reports/mutation/stryker-6425-frontend.json" },
	"tempDirName": ".stryker-tmp-6425"
}
