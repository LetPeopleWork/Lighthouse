{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Models/PortfolioSize.cs",
      "**/API/DTO/PortfolioSizeDto.cs",
      "**/API/PortfolioController.cs",
      "**/Services/Implementation/BackgroundServices/Update/PortfolioUpdater.cs",
      "**/Services/Implementation/Repositories/PortfolioRepository.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~PortfolioSizeTest|FullyQualifiedName~PortfolioRepositoryTest|FullyQualifiedName~PortfolioUpdaterTest|FullyQualifiedName~API.PortfolioControllerTest)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Integration.Containers&FullyQualifiedName!~Dogfood&TestCategory!=Integration&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
