{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/Repositories/FeatureRepository.cs",
      "**/Services/Implementation/InProgressFeatureResolution.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Repositories.FeatureRepositoryTest|FullyQualifiedName~FeatureGraphReaderRelationalTest|FullyQualifiedName~FeaturesWithReferenceIdsRelationalTest|FullyQualifiedName~InProgressFeatureResolutionTest|FullyQualifiedName~Implementation.TeamMetricsServiceTests|FullyQualifiedName~DependencyVerdictIdentityTest)&FullyQualifiedName!~Dogfood&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Integration.Containers&TestCategory!=Integration&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
