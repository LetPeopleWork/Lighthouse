{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/API/FeatureListController.cs",
      "**/API/FeatureListRows.cs",
      "**/Services/Implementation/FeatureListService.cs",
      "**/Services/Implementation/FeatureListActiveWork.cs",
      "**/Services/Implementation/Dependencies/FeatureDependencyRendering.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Implementation.FeatureListServiceTest|FullyQualifiedName~API.FeatureListRowsTest|FullyQualifiedName~API.FeatureListControllerTest|FullyQualifiedName~FeatureDependencyRenderingTest|FullyQualifiedName~API.FeaturesControllerTest|FullyQualifiedName~Slice04OneListPerOwnerScenarios)&FullyQualifiedName!~Dogfood&FullyQualifiedName!~Integration.Containers&TestCategory!=Integration&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
