{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/BackgroundServices/Update/ForecastUpdater.cs",
      "**/Services/Implementation/Repositories/FeatureRepository.cs",
      "**/Services/Implementation/Repositories/PortfolioRepository.cs",
      "**/Services/Implementation/DomainEvents/DeliveryForecastPublishingHandler.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~ForecastUpdaterTest|FullyQualifiedName~ForecastGatherReaderRelationalTest|FullyQualifiedName~Repositories.FeatureRepositoryTest|FullyQualifiedName~FeatureGraphReaderRelationalTest|FullyQualifiedName~FeaturesWithReferenceIdsRelationalTest|FullyQualifiedName~PortfolioRepositoryTest|FullyQualifiedName~PortfolioCatalogueReaderRelationalTest|FullyQualifiedName~DeliveryForecastPublishingHandlerTest|FullyQualifiedName~ForecastConfirmationRepositoryRelationalTest|FullyQualifiedName~Repositories.DeletionTests)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Integration.Containers&FullyQualifiedName!~Dogfood&TestCategory!=Integration&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
