{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.mutation.ts" },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": ["/dist", "/coverage", "/playwright-report", "/reports"],
  "incrementalFile": "reports/mutation/stryker-incremental-6712.json",
  "mutate": [
    "src/hooks/usePageFreshQuery.ts",
    "src/hooks/askSharedReadsAgainFor.ts",
    "src/hooks/pageOfTheLatestAsk.ts",
    "src/hooks/pageFreshQueryKey.ts",
    "src/hooks/useRbac.ts:36-62",
    "src/hooks/useUnitLists.ts",
    "src/hooks/useLicenseRestrictions.ts:24-41",
    "src/hooks/useLicenseRestrictions.ts:79-86",
    "src/hooks/useLicenseRestrictions.ts:122-122",
    "src/components/App/PageMoveRefresh/PageMoveRefresh.tsx",
    "src/components/App/LetPeopleWork/LighthouseVersion.tsx:90-122",
    "src/components/App/LetPeopleWork/LighthouseVersion.tsx:195-196",
    "src/components/App/LetPeopleWork/LighthouseVersion.tsx:270-285",
    "src/components/App/LetPeopleWork/LatestReleaseInformationDialog.tsx:43-71",
    "src/components/App/LetPeopleWork/LatestReleaseInformationDialog.tsx:119-139"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "jsonReporter": { "fileName": "reports/mutation/stryker-6712-frontend.json" },
  "tempDirName": ".stryker-tmp-6712"
}
