{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["../Lighthouse.Backend.Tests/Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Models/Delivery.cs",
      "**/Models/DeliveryClosureRecord.cs",
      "**/Models/DeliveryArchivedException.cs",
      "**/Services/Implementation/DeliveryMetricValuesProjector.cs",
      "**/Services/Implementation/DeliveryRuleService.cs",
      "**/Services/Implementation/DomainEvents/DeliveryMetricSnapshotRecordingHandler.cs",
      "**/Services/Implementation/Repositories/DeliveryRepository.cs",
      "**/Services/Interfaces/Repositories/RecordableDeliveries.cs",
      "**/API/DeliveriesController.cs",
      "**/API/DeliveryNotesController.cs",
      "**/API/DTO/Archived/ArchivedDeliveryProjection.cs",
      "**/API/DTO/Archived/ArchivedDeliveryDto.cs",
      "**/API/DTO/Archived/ArchivedDeliveryIdentity.cs",
      "**/API/DTO/Archived/PortfolioDeliveriesDto.cs",
      "**/API/Filters/DeliveryArchivedExceptionFilter.cs"
    ],
    "ignore-methods": [
      "*Log*",
      "Console.*"
    ],
    "ignore-mutations": ["string"],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Delivery|FullyQualifiedName~Archived|FullyQualifiedName~PortfolioUpdater)&TestCategory!=JiraIntegration&TestCategory!=AdoIntegration&TestCategory!=LinearIntegration&TestCategory!=ServiceNowIntegration&TestCategory!=GithubIntegration&TestCategory!=Integration&TestCategory!=requires-docker&TestCategory!=real-io",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
