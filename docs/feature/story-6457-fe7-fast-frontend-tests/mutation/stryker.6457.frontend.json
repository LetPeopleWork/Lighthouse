{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.mutation.ts" },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "perTest",
  "incrementalFile": "reports/mutation/stryker-incremental-6457.json",
  "concurrency": 2,
  "timeoutMS": 120000,
  "timeoutFactor": 3,
  "dryRunTimeoutMinutes": 30,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": ["/dist", "/coverage", "/playwright-report", "/reports"],
  "mutate": [
    "src/components/Common/Connection/defaultsKeepingOnlyFields.ts",
    "src/components/Common/Connection/whatASaveAsks.ts",
    "src/components/Common/ProjectSettings/portfolioAutoSaveBlockers.ts",
    "src/components/Common/Team/discussionRules.ts",
    "src/components/Common/Team/teamAutoSaveBlockers.ts",
    "src/pages/Common/Reports/wizard/reportWizardRules.ts",
    "src/pages/Reports/bulkWizardSteps.ts",
    "src/pages/Reports/ownerLimitOfWindow.ts",
    "src/pages/Reports/pickLimit.ts",
    "src/pages/Reports/pickedReports.ts",
    "src/pages/Teams/Detail/Refinement/refinementHeading.ts",
    "src/pages/Teams/Detail/Refinement/refinementPaging.ts",
    "src/tests/timeBudget/compareToAllowList.ts",
    "src/tests/timeBudget/observedRunFromVitest.ts",
    "src/tests/timeBudget/timeBudgetOptions.ts"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "jsonReporter": { "fileName": "reports/mutation/stryker-6457-frontend.json" },
  "tempDirName": ".stryker-tmp-6457"
}
