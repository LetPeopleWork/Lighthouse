{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.stryker.sleRiskCorrections.ts",
    "related": false
  },
  "mutate": [
    "src/hooks/useAgingBackground.ts"
  ],
  "inPlace": true,
  "disableTypeChecks": false,
  "coverageAnalysis": "off",
  "concurrency": 2,
  "reporters": [
    "html",
    "json",
    "progress"
  ],
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 0
  }
}
