{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "../Lighthouse.Backend.Tests/Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Models/UsageData/UsageDataEventShapes.cs",
      "**/API/UsageDataController.cs",
      "**/Services/Implementation/UsageData/PostHogUsageDataPublisher.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "FullyQualifiedName~OptionalFeatureToggledEventTests|FullyQualifiedName~Slice04ProductEventsTests|FullyQualifiedName~UsageDataControllerTests|FullyQualifiedName~UsageDataPublishedMessageTests|FullyQualifiedName~UsageDataEmitSeam",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 120000,
    "verbosity": "info"
  }
}
