{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Modules/TrackerIntegration/Adapters/Connectors/Jira/JiraWorkTrackingConnector.cs",
      "**/Modules/TrackerIntegration/Adapters/Connectors/Jira/IssueFactory.cs",
      "**/Modules/TrackerIntegration/Adapters/Connectors/Jira/JiraRestRoutes.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTest",
    "test-case-filter": "FullyQualifiedName~Connectors.Jira&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration&TestCategory!=GithubIntegration&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Dogfood",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
