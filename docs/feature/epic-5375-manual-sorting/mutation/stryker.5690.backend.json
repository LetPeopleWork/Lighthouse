{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/FeatureRankingService.cs",
      "**/Services/Implementation/Authorization/FeatureMoveAuthorization.cs",
      "**/Services/Implementation/BackgroundServices/Update/FeatureRankChangedForecastTriggerHandler.cs",
      "**/Models/FeatureMoveVerdict.cs",
      "**/API/FeaturesController.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "FullyQualifiedName~ManualSorting|FullyQualifiedName~FeaturesController|FullyQualifiedName~FeatureRankChangedForecastTriggerHandler",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
