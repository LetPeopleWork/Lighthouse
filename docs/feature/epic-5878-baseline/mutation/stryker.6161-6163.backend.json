{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Models/Reports/ReportRefusalCodes.cs",
      "**/Services/Implementation/Reports/TeamReportMetricSeries.cs",
      "**/Services/Implementation/Reports/ThenAndNowTemplate.cs",
      "**/Services/Implementation/Reports/Metrics/CycleTimeReportMetric.cs",
      "**/Services/Implementation/Reports/Metrics/DailySeriesSummary.cs",
      "**/Services/Implementation/Reports/Metrics/ThroughputReportMetric.cs",
      "**/Services/Implementation/Reports/Metrics/WindowedReportMetric.cs",
      "**/Services/Implementation/Reports/Metrics/WipReportMetric.cs",
      "**/Services/Implementation/Reports/Metrics/WorkItemAgeReportMetric.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTest",
    "test-case-filter": "(FullyQualifiedName~Reports|FullyQualifiedName~TeamMetricsService)&FullyQualifiedName!~ReportCreationTimingProbe&TestCategory!=Integration&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
