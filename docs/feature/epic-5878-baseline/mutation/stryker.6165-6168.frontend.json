{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.6165-6168.config.ts" },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental-6165-6168.json",
  "concurrency": 3,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": ["/dist", "/coverage", "/playwright-report", "/reports"],
  "mutate": [
    "src/pages/Common/Reports/wizard/ReportWizard.tsx",
    "src/pages/Common/Reports/wizard/TypeStep.tsx",
    "src/pages/Common/Reports/wizard/reportRefusalCopy.ts",
    "src/pages/Common/Reports/wizard/reportTypes.ts",
    "src/pages/Common/Reports/wizard/reportWindowCheck.ts",
    "src/pages/Common/Reports/wizard/thenAndNow/*.ts",
    "src/pages/Common/Reports/wizard/thenAndNow/*.tsx",
    "!src/pages/Common/Reports/wizard/thenAndNow/*.test.ts",
    "!src/pages/Common/Reports/wizard/thenAndNow/*.test.tsx",
    "src/pages/Common/Reports/ReportList.tsx",
    "src/pages/Common/Reports/ReportView.tsx",
    "src/pages/Common/Reports/ReportsTab.tsx",
    "src/pages/Common/Reports/ThenAndNowHeader.tsx",
    "src/pages/Common/Reports/reportOwner.ts",
    "src/pages/Common/Reports/useMayEditReports.ts",
    "src/pages/Common/Reports/useOwnerReports.ts",
    "src/pages/Common/Reports/useReportDeletion.tsx",
    "src/pages/Common/Reports/useReportEditing.tsx",
    "src/components/Common/DeleteConfirmationDialog/DeleteConfirmationDialog.tsx:15-80",
    "src/pages/Overview/OverviewDashboard.tsx:45-104",
    "src/pages/Overview/OverviewDashboard.tsx:225-260",
    "src/pages/Overview/OverviewDashboard.tsx:680-690"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "jsonReporter": { "fileName": "/tmp/claude-1000/stryker-6165-6168-frontend.json" },
  "tempDirName": ".stryker-tmp-6165-6168"
}
