{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Models/Reports/Report.cs",
      "**/Models/Reports/ReportReadModels.cs",
      "**/Models/Reports/ReportRefusalCodes.cs",
      "**/Models/Reports/ThenAndNowPayload.cs",
      "**/Services/Implementation/Reports/ReportCommands.cs",
      "**/Services/Implementation/Reports/ReportOwnerLookup.cs",
      "**/Services/Implementation/Reports/ReportQueries.cs",
      "**/Services/Implementation/Reports/ReportWindowPolicy.cs",
      "**/Services/Implementation/Reports/TeamReportMetricSeries.cs",
      "**/Services/Implementation/Reports/ThenAndNowTemplate.cs",
      "**/Services/Implementation/Reports/Metrics/CycleTimeReportMetric.cs",
      "**/Services/Implementation/Reports/Metrics/ReportMetricCatalog.cs",
      "**/Services/Implementation/Repositories/ReportRepository.cs",
      "**/Services/Interfaces/Reports/ReportOwner.cs",
      "**/API/TeamReportsController.cs",
      "**/API/DTO/Reports/NewReportRequest.cs",
      "**/Models/UsageData/UsageDataEventShapes.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Reports|FullyQualifiedName~ReportRepository|FullyQualifiedName~UsageDataEventShapes|FullyQualifiedName~ReportUsageEvents)&FullyQualifiedName!~ReportCreationTimingProbe&TestCategory!=Integration&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
