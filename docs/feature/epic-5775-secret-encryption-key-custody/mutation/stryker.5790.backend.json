{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/Encryption/StoredSecretReadabilityProbe.cs",
      "**/Services/Implementation/Encryption/EncryptionKeyRingBootstrapper.cs",
      "**/Startup/StartupBanner.cs",
      "**/API/DTO/EncryptionStateDto.cs"
    ],
    "thresholds": { "high": 90, "low": 80, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~EncryptionKeyRing|FullyQualifiedName~StoredSecretReadabilityProbe|FullyQualifiedName~EncryptionBootstrapOrder|FullyQualifiedName~StartupBanner|FullyQualifiedName~EncryptionController|FullyQualifiedName~EncryptionRecord|FullyQualifiedName~SecretEncryptionOnSave|FullyQualifiedName~SecretCustody|FullyQualifiedName~PublishedKeySecret|FullyQualifiedName~CryptoService|FullyQualifiedName~GeneratedKeyRingStore|FullyQualifiedName~ConfiguredKeyRingSource|FullyQualifiedName~KeyStoreResolver)&(FullyQualifiedName!~Containers)",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
