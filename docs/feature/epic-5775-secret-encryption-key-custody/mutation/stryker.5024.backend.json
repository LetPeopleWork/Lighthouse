{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/Encryption/KeyRingSerializer.cs",
      "**/Services/Implementation/Encryption/KeyStoreResolver.cs",
      "**/Services/Implementation/Encryption/KeyStoreMigration.cs",
      "**/Services/Implementation/Encryption/EncryptionKeyRingBootstrapper.cs",
      "**/Services/Implementation/Encryption/ConfiguredKeyRingSource.cs",
      "**/Services/Implementation/Encryption/MountedFileKeyRingSource.cs",
      "**/Services/Implementation/Encryption/GeneratedKeyRingStore.cs",
      "**/Services/Implementation/Encryption/DatabaseSecretPresenceProbe.cs",
      "**/Services/Implementation/Encryption/LegacyDefaultEncryptionKey.cs",
      "**/Models/Encryption/KeyCustody.cs",
      "**/Startup/StartupBanner.cs",
      "**/Models/Encryption/EncryptionKeyRing.cs",
      "**/API/EncryptionController.cs",
      "**/API/DTO/EncryptionStateDto.cs"
    ],
    "thresholds": { "high": 90, "low": 80, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Encryption|FullyQualifiedName~KeyRing|FullyQualifiedName~KeyStore|FullyQualifiedName~KeyCustody|FullyQualifiedName~Crypto|FullyQualifiedName~StartupBanner|FullyQualifiedName~SecretCustody)&(FullyQualifiedName!~Containers)",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
