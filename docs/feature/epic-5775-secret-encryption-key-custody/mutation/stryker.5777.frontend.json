{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.mutation.ts" },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": ["dist", "coverage", "playwright-report", "reports"],
  "mutate": [
    "src/components/Common/Connection/SecretHandlingNotice.tsx",
    "src/components/Common/Connection/ModifyConnectionSettings.tsx:50-76",
    "src/components/Common/Connection/ModifyConnectionSettings.tsx:243-247",
    "src/components/Common/Connection/ModifyConnectionSettings.tsx:479-482",
    "src/components/Common/Connection/ModifyConnectionSettings.tsx:560-564",
    "src/components/Common/Connection/ModifyConnectionSettings.tsx:620-627",
    "src/components/Common/Connection/CreateConnectionWizard.tsx:439-443",
    "src/components/Common/Connection/CreateConnectionWizard.tsx:478-479",
    "src/models/WorkTracking/WorkTrackingSystemOption.ts"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "jsonReporter": { "fileName": "stryker-5777.json" },
  "tempDirName": ".stryker-tmp-5777"
}
