{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/BackgroundServices/KeyRingFileWatcher.cs",
      "**/Services/Implementation/Encryption/MountedFileKeyRingSource.cs"
    ],
    "thresholds": { "high": 90, "low": 80, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~KeyRingFileWatcher|FullyQualifiedName~KeyRingFileReload|FullyQualifiedName~MountedFileKeyRingSource|FullyQualifiedName~KeyRingSerializer|FullyQualifiedName~EncryptionKeyRingBootstrapper)&(FullyQualifiedName!~Containers)",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
