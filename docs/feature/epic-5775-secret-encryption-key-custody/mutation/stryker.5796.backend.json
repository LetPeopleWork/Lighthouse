{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["../Lighthouse.Backend.Tests/Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/Encryption/SecretCustodyService.cs",
      "**/Services/Implementation/CryptoService.cs",
      "**/Models/Encryption/SecretReadabilityReport.cs"
    ],
    "thresholds": { "high": 90, "low": 80, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Encryption|FullyQualifiedName~SecretCustody|FullyQualifiedName~Crypto)&(FullyQualifiedName!~Containers)",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
