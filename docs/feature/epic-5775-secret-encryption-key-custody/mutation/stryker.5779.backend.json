{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/Encryption/SecretCustodyService.cs",
      "**/Services/Implementation/Encryption/PublishedKeySecretCount.cs",
      "**/Models/Encryption/SecretReadabilityReport.cs",
      "**/API/EncryptionController.cs",
      "**/API/DTO/SecretReadabilityReportDto.cs",
      "**/API/DTO/EncryptionStateDto.cs"
    ],
    "thresholds": { "high": 90, "low": 80, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~SecretCustody|FullyQualifiedName~SecretReadability|FullyQualifiedName~PublishedKeySecret|FullyQualifiedName~EncryptionController|FullyQualifiedName~EncryptionRecord)&(FullyQualifiedName!~Containers)",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
