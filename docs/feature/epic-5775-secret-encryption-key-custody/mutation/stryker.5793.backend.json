{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Models/SystemInfo.cs",
      "**/API/SystemInfoController.cs",
      "**/Services/Implementation/Encryption/StoredSecretSummaryReader.cs"
    ],
    "thresholds": { "high": 90, "low": 80, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~SystemInfo|FullyQualifiedName~SurveyNudge|FullyQualifiedName~EncryptionController|FullyQualifiedName~EncryptionRecord|FullyQualifiedName~StartupBanner)&(FullyQualifiedName!~Containers)",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
