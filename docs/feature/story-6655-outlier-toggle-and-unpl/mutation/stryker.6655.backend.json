{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Modules/FlowMetrics/Application/CycleTimeOutlierDefinition.cs",
      "**/API/DTO/CycleTimeOutliersDto.cs",
      "**/Modules/FlowMetrics/Domain/XmRCalculator.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "ignore-methods": [
      "*Log*",
      "Console.*"
    ],
    "coverage-analysis": "perTest",
    "test-case-filter": "(FullyQualifiedName~Tests.Modules.FlowMetrics.Domain.XmRCalculatorTest|FullyQualifiedName~Tests.Modules.FlowMetrics.Application.CycleTimeOutlierDefinitionTest|FullyQualifiedName~Tests.API.DTO.CycleTimeOutliersDtoTest|FullyQualifiedName~Tests.Acceptance.CycleTimeOutliers)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Integration.Containers&FullyQualifiedName!~Dogfood&FullyQualifiedName!~Tests.Contracts&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration&TestCategory!=GithubIntegration",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 3,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
