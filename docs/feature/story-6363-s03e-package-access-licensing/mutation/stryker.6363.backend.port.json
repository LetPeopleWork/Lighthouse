{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Modules/Access/Domain/**/*.cs",
      "**/Modules/Access/Application/**/*.cs",
      "**/Modules/Access/Adapters/Http/**/*.cs",
      "**/Modules/Licensing/**/*.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Lighthouse.Backend.Tests.Modules.Access|FullyQualifiedName~Lighthouse.Backend.Tests.Modules.Licensing|FullyQualifiedName~Tests.API.ApiKeyControllerTest|FullyQualifiedName~Tests.API.AuthControllerTest|FullyQualifiedName~Tests.API.AuthorizationControllerTest|FullyQualifiedName~Tests.API.LicenseControllerTest|FullyQualifiedName~Tests.API.CreateRightsControllerGuardTest|FullyQualifiedName~Tests.API.EmbedStartControllerTest|FullyQualifiedName~Tests.API.EndpointAuthorizationPolicyTest|FullyQualifiedName~Tests.Services.Implementation.Seeding.ApiKeyOwnerReconciliationSeederTests|FullyQualifiedName~Tests.Acceptance.SystemWideAccess)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~RemovedPersonEmbedSkeleton&FullyQualifiedName!~Dogfood&FullyQualifiedName!~WriteBack&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration&TestCategory!=GithubIntegration",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}