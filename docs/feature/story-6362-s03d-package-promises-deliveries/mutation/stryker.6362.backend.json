{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Modules/Promises/Domain/**/*.cs",
      "**/Modules/Promises/Application/**/*.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Lighthouse.Backend.Tests.Modules.Promises|FullyQualifiedName~DeliveriesController|FullyQualifiedName~DeliveryRulesController|FullyQualifiedName~DeliverySourcesController|FullyQualifiedName~PortfolioUpdaterTest|FullyQualifiedName~JiraBatchedWriteBack|FullyQualifiedName~JiraQuietWriteBack|FullyQualifiedName~JiraDeliverySourceProvider|FullyQualifiedName~JiraDeliveryForecastPublisher)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Acceptance&FullyQualifiedName!~Dogfood&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration&TestCategory!=GithubIntegration",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
