{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/API/ReportNotesControllerBase.cs",
      "**/Modules/Reports/Domain/ReportNoteCaller.cs",
      "**/Services/Implementation/Repositories/ReportRepository.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "FullyQualifiedName~ReportNotesWireContractTest|FullyQualifiedName~ReportNotesControllerCallerTest|FullyQualifiedName~ReportNoteCallerTest|FullyQualifiedName~ReportRepositoryTest|FullyQualifiedName~Acceptance.ReportNotes",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
