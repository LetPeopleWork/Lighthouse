{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/WriteBackCollector.cs",
      "**/Services/Implementation/WriteBackService.cs",
      "**/Services/Implementation/WriteBackTriggerService.cs",
      "**/Services/Implementation/BackgroundServices/Update/UpdateServiceBase.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~WriteBack)|(FullyQualifiedName~Updater)|(FullyQualifiedName~QuietWriteBack)|(FullyQualifiedName~BlackoutForecastShift)",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
