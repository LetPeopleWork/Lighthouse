{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Services/Implementation/BackgroundServices/OverTimeHistoryFiller.cs",
      "**/Services/Implementation/BackgroundServices/OverTimeFillTarget.cs",
      "**/Services/Implementation/BackgroundServices/RetentionEdge.cs",
      "**/Services/Implementation/BackgroundServices/ReconstructionMemo.cs",
      "**/Services/Implementation/OverTimeGapReconciler.cs",
      "**/Services/Implementation/OverTimeHistoryFillSwitch.cs",
      "**/Services/Implementation/PercentileSnapshotWriter.cs",
      "**/Services/Implementation/ProcessBehaviorSnapshotWriter.cs",
      "**/Services/Implementation/LostRaceTolerantSave.cs",
      "**/Services/Implementation/PercentileFamilies.cs",
      "**/Services/Implementation/GapAskingPercentilesOverTimeSeriesQuery.cs",
      "**/Services/Implementation/GapAskingProcessBehaviorSeriesQuery.cs",
      "**/Services/Implementation/DatabaseManagement/DatabaseMaintenanceGate.cs",
      "**/Services/Implementation/DomainEvents/PercentilesOverTimeRecordingHandler.cs",
      "**/Services/Implementation/DomainEvents/ProcessBehaviorRecordingHandler.cs",
      "**/API/OptionalFeaturesController.cs",
      "**/Services/Implementation/Seeding/OptionalFeatureSeeder.cs"
