    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~OverTimeHistoryFillerTest|FullyQualifiedName~RetentionEdgeTest|FullyQualifiedName~ReconstructionMemoTest|FullyQualifiedName~LostRaceTolerantSaveTest|FullyQualifiedName~PercentileSnapshotWriterTest|FullyQualifiedName~ProcessBehaviorSnapshotWriterTest|FullyQualifiedName~OverTimeHistoryFillSwitchTest|FullyQualifiedName~GapAskingSeriesQueryTest|FullyQualifiedName~OverTimeFillTargetTest|FullyQualifiedName~OverTimeGapReconcilerTest|FullyQualifiedName~DatabaseMaintenanceGateTest|FullyQualifiedName~PercentilesOverTimeRecordingHandlerTests|FullyQualifiedName~ProcessBehaviorRecordingHandlerTests|FullyQualifiedName~SnapshotRecordedDayInstanceZoneTest|FullyQualifiedName~OptionalFeatureSeederTests|FullyQualifiedName~OptionalFeaturesControllerTest)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Integration.Containers",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
