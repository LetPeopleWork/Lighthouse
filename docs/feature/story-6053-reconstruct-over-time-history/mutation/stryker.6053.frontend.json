{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.mutation.ts" },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": ["dist", "coverage", "playwright-report", "reports"],
  "mutate": [
    "src/pages/Common/MetricsView/overTimeEmptyState.ts:17-18",
    "src/pages/Common/MetricsView/PbcOverTimeWidget.tsx:256-256",
    "src/pages/Common/MetricsView/PercentilesOverTimeWidget.tsx:208-208"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "jsonReporter": { "fileName": "stryker-6053-frontend.json" },
  "tempDirName": ".stryker-tmp-6053"
}
