{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Models/Forecast/StartForecast.cs",
      "**/Models/Forecast/FeatureStart.cs",
      "**/Models/Feature.cs",
      "**/Services/Implementation/Forecast/TrialRecordings.cs",
      "**/Services/Implementation/Forecast/TrialState.cs",
      "**/Services/Implementation/Forecast/SimulatedRun.cs",
      "**/Services/Implementation/Forecast/ForecastRunPlan.cs",
      "**/Services/Implementation/Forecast/ForecastService.cs",
      "**/Services/Implementation/Forecast/DayCounts.cs",
      "**/API/DTO/FeatureStartDto.cs",
      "**/API/DTO/WhenForecastDto.cs",
      "**/API/DTO/DtoExtensions.cs",
      "**/API/DTO/FeatureDto.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~ForecastServiceStartDayTest|FullyQualifiedName~FeatureWhenWorkBeginsTest|FullyQualifiedName~FeatureStartDtoTest|FullyQualifiedName~FeatureDtoStartForecastTest|FullyQualifiedName~ForecastServiceTest|FullyQualifiedName~ForecastServiceDependencyTest|FullyQualifiedName~ForecastServiceCrossTeamDependencyTest|FullyQualifiedName~MultiTeamJointForecastTest|FullyQualifiedName~ForecastRunThatCannotEndTest|FullyQualifiedName~WhenForecastTest|FullyQualifiedName~AggregatedWhenForecastTest|FullyQualifiedName~FeatureTest|FullyQualifiedName~FeatureMissingForecastRowTest)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Integration.Containers",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 60000,
    "verbosity": "info"
  }
}
