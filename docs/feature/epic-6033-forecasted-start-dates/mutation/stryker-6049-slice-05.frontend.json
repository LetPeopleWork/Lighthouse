{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "vitest.stryker.6049-slice-05.config.ts"
  },
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "inPlace": true,
  "disableTypeChecks": false,
  "ignorePatterns": [
    "dist",
    "coverage",
    "playwright-report",
    "reports"
  ],
  "mutate": [
    "src/pages/Portfolios/Detail/Components/DeliveryGrid/timeline/deliveryDependencyOverlay.ts",
    "src/pages/Portfolios/Detail/Components/DeliveryGrid/timeline/ganttShapes.ts",
    "src/pages/Portfolios/Detail/Components/DeliveryGrid/timeline/DeliveryGanttChart.tsx",
    "src/pages/Portfolios/Detail/Components/DeliveryGrid/timeline/TimelineBarContent.tsx",
    "src/pages/Portfolios/Detail/Components/DeliveryGrid/timeline/DeliveryTimelineTab.tsx",
    "src/utils/dependencies/dependencySentences.ts",
    "src/utils/features/featureWarningSentences.ts",
    "src/components/Common/WorkItemsDialog/WorkItemsDialog.tsx"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 0
  },
  "jsonReporter": {
    "fileName": "stryker-6049-slice-05-frontend.json"
  },
  "tempDirName": ".stryker-tmp-6049-slice-05"
}
