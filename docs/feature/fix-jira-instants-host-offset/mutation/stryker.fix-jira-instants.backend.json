{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Factories/IssueFactory.cs",
      "**/Services/Implementation/WorkItems/WorkItemService.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~IssueFactory|FullyQualifiedName~WorkItemServiceTest|FullyQualifiedName~JiraIncrementalSyncTest|FullyQualifiedName~ZonedTimestampParsingArchUnitTest)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Dogfood",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
