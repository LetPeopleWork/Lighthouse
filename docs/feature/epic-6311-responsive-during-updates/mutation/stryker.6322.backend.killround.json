{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/API/UpdateController.cs",
      "**/Services/Implementation/BackgroundServices/Update/UpdateQueueService.cs",
      "**/Services/Implementation/RefreshRoundSummaryLine.cs",
      "**/Services/Implementation/WriteBackCollector.cs",
      "**/Services/Implementation/WriteBackRound.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~BackgroundServices.Update|FullyQualifiedName~UpdateControllerTest|FullyQualifiedName~DatabaseMaintenanceGateTest|FullyQualifiedName~WriteBackCollectorTest|FullyQualifiedName~WriteBackRoundTest|FullyQualifiedName~Slice05CancelAllScenarios)&FullyQualifiedName!~Dogfood&FullyQualifiedName!~Integration.Containers&TestCategory!=Integration&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
