{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/API/DTO/DeliveryMetricsHistoryDto.cs",
      "**/API/DTO/WhenForecastDto.cs",
      "**/API/FeatureForecastWindow.cs",
      "**/Models/DeliveryMetricsProjection.cs",
      "**/Models/DeliverySources/DeliveryForecastBlock.cs",
      "**/Models/Forecast/AggregatedWhenForecast.cs",
      "**/Models/Forecast/DeliveryCompletionForecast.cs",
      "**/Models/Forecast/ForecastBase.cs",
      "**/Models/Forecast/ForecastHorizon.cs",
      "**/Models/Forecast/ForecastPercentile.cs",
      "**/Models/Forecast/ForecastSimulationLimits.cs",
      "**/Models/Forecast/StartForecast.cs",
      "**/Models/Forecast/WhenForecast.cs",
      "**/Models/SimulationResult.cs",
      "**/Services/Implementation/Forecast/ForecastService.cs",
      "**/Services/Implementation/Forecast/HowTheRunEnded.cs",
      "**/Services/Implementation/Forecast/OneWorkersShareOfTheRuns.cs",
      "**/Services/Implementation/Forecast/SimulatedRun.cs",
      "**/Services/Implementation/Forecast/WhatTheRunsCouldNotFinish.cs",
