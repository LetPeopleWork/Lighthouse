    "test-case-filter": "(FullyQualifiedName~Models.Forecast|FullyQualifiedName~Services.Implementation.Forecast|FullyQualifiedName~BackgroundServices.Update|FullyQualifiedName~DeliveryMetricValuesProjector|FullyQualifiedName~DeliverySources.DeliveryForecast|FullyQualifiedName~WriteBackTriggerService|FullyQualifiedName~WriteBackCollector|FullyQualifiedName~StartupBanner|FullyQualifiedName~FeatureForecastWindow|FullyQualifiedName~API.DTO|FullyQualifiedName~ForecastController|FullyQualifiedName~Models.Delivery|FullyQualifiedName~Models.Feature|FullyQualifiedName~DeliveriesController)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Dogfood&FullyQualifiedName!~Integration.Containers&TestCategory!=Integration&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
