{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "../Lighthouse.Backend.Tests/Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Services/Implementation/WorkItems/SyncModeResolver.cs",
      "**/Services/Implementation/Seeding/OptionalFeatureSeeder.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~SyncModeResolverTest|FullyQualifiedName~OptionalFeatureSeederTests|FullyQualifiedName~WorkItemServiceTest)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~Integration.Containers",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 120000,
    "verbosity": "info"
  }
}
