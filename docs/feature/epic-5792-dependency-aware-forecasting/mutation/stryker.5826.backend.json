{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/BackgroundServices/Update/ForecastUpdater.cs",
      "**/Services/Implementation/BackgroundServices/Update/UpdateQueueService.cs",
      "**/Services/Implementation/BackgroundServices/Update/UpdateServiceBase.cs",
      "**/Services/Implementation/BackgroundServices/Update/PortfolioUpdater.cs",
      "**/Services/Implementation/BackgroundServices/Update/InProcessUpdateStatusStore.cs",
      "**/Services/Implementation/BackgroundServices/Update/RedisUpdateStatusStore.cs",
      "**/Services/Implementation/BackgroundServices/Update/TeamDataRefreshedForecastTriggerHandler.cs",
      "**/Services/Implementation/BackgroundServices/Update/FeatureRankChangedForecastTriggerHandler.cs",
      "**/Services/Implementation/BackgroundServices/Update/FeatureOrderingPolicyChangedForecastTriggerHandler.cs",
      "**/Services/Implementation/WriteBackRound.cs",
      "**/Services/Implementation/WriteBackRoundContext.cs",
      "**/Services/Implementation/RefreshRoundSummary.cs",
      "**/Services/Implementation/WriteBackCollector.cs",
      "**/Services/Implementation/Repositories/PortfolioRepository.cs",
      "**/Services/Implementation/Repositories/TeamRepository.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~BackgroundServices.Update|FullyQualifiedName~DependencyAwareForecasting|FullyQualifiedName~WriteBack|FullyQualifiedName~PortfolioRepositoryTest|FullyQualifiedName~TeamRepositoryTest|FullyQualifiedName~RefreshLogServiceTest|FullyQualifiedName~UpdateStatusStoreContainerTests)&TestCategory!=Integration&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
