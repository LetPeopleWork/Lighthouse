{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": ["Lighthouse.Backend.Tests.csproj"],
    "mutate": [
      "**/Services/Implementation/Forecast/ForecastService.cs",
      "**/Services/Implementation/Dependencies/DependencyHonourPolicy.cs",
      "**/Services/Implementation/Dependencies/DependencyDecision.cs",
      "**/Services/Implementation/Dependencies/DependencyFacts.cs",
      "**/Services/Implementation/Dependencies/WhatTheForecastWaitsFor.cs",
      "**/Services/Implementation/Dependencies/DependencyRefreshReporter.cs",
      "**/Models/Dependencies/ForecastWaits.cs"
    ],
    "thresholds": { "high": 80, "low": 70, "break": 0 },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Dependenc|FullyQualifiedName~Forecast)&TestCategory!=Integration&TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration",
    "reporters": ["progress", "json", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
