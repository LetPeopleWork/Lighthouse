{
  "stryker-config": {
    "project": "Lighthouse.Backend.csproj",
    "solution": "../Lighthouse.sln",
    "test-projects": [
      "Lighthouse.Backend.Tests.csproj"
    ],
    "mutate": [
      "**/Services/Implementation/Encryption/LegacyDefaultEncryptionKey.cs",
      "**/Models/Encryption/EncryptionKeyRing.cs",
      "**/Models/BlackoutDaysExtensions.cs",
      "**/Models/Reports/ReportOwner.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "test-case-filter": "(FullyQualifiedName~Encryption|FullyQualifiedName~Blackout|FullyQualifiedName~ReportOwner)&FullyQualifiedName!~API.Integration&FullyQualifiedName!~IntegrationTest&FullyQualifiedName!~Dogfood",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 4,
    "additional-timeout": 30000,
    "verbosity": "info"
  }
}
