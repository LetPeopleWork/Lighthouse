{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.mutation.config.ts" },
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "perTest",
  "concurrency": 6,
  "timeoutMS": 120000,
  "inPlace": true,
  "mutate": [
    "src/pages/Common/MetricsView/categoryMetadata.ts",
    "src/pages/Common/MetricsView/useCategorySelection.ts",
    "src/hooks/useMetricsData.ts",
    "src/components/Common/Charts/TotalWorkItemAgeWidget.tsx"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 80 },
  "jsonReporter": { "fileName": "stryker-bug5571.json" },
  "tempDirName": ".stryker-tmp-bug5571"
}
