{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"packageManager": "pnpm",
	"testRunner": "vitest",
	"plugins": ["@stryker-mutator/vitest-runner"],
	"vitest": {
		"configFile": "vitest.config.ts",
		"dir": "src/tests/timeBudget",
		"related": false
	},
	"reporters": ["clear-text", "progress", "json"],
	"coverageAnalysis": "perTest",
	"incremental": true,
	"incrementalFile": "reports/mutation/stryker-incremental-6536.json",
	"concurrency": 4,
	"timeoutMS": 60000,
	"inPlace": true,
	"disableTypeChecks": false,
	"ignorePatterns": ["/dist", "/coverage", "/playwright-report", "/reports"],
	"mutate": [
		"src/tests/timeBudget/compareToAllowList.ts:65-69",
		"src/tests/timeBudget/compareToAllowList.ts:76-76",
		"src/tests/timeBudget/compareToAllowList.ts:104-104",
		"src/tests/timeBudget/timeBudgetReporter.ts:55-55"
	],
	"thresholds": { "high": 90, "low": 80, "break": 0 },
	"jsonReporter": { "fileName": "reports/mutation/stryker-6536-frontend.json" },
	"tempDirName": ".stryker-tmp-6536"
}
