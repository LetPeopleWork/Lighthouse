`const [$state, $setter] = $call` where {
    $call <: r"(?:React\.)?useState\b[\s\S]*",
    $setter <: not r"set[A-Z][A-Za-z0-9]*",
    register_diagnostic(span=$setter, message="Name the useState pair [thing, setThing]. If a hook hands you a wrapped setter, give the wrapper its own verb instead of a set- name.", severity="error")
}
