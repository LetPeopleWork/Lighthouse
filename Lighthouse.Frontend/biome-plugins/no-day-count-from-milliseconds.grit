`$elapsed / $day` where {
    $day <: or {
        r"\(?\s*1000\s*\*\s*60\s*\*\s*60\s*\*\s*24\s*\)?",
        r"\(?\s*24\s*\*\s*60\s*\*\s*60\s*\*\s*1000\s*\)?",
        r"86_?400_?000",
        r"(?i)(?:ms|millis|milliseconds)_?per_?day|(?:one_?)?day_?(?:in_?)?(?:ms|milliseconds)"
    },
    register_diagnostic(span=$day, message="Dividing milliseconds by 24 hours counts 24-hour blocks, not calendar days: across a daylight-saving change one day is 23 or 25 hours, so the count comes out one day off near midnight. Count calendar days with differenceInCalendarDays from date-fns.", severity="error")
}
