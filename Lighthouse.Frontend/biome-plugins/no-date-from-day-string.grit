`new Date($text)` where {
    $text <: r"[\"'`]\d{4}-\d{2}-\d{2}[\"'`]",
    register_diagnostic(span=$text, message="A date-only string such as 2026-08-20 is read as UTC midnight, which is the previous day west of Greenwich. Turn a day key into a date with the helpers in src/utils/date/localDate.ts.", severity="error")
}
