{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"packageManager": "pnpm",
	"testRunner": "vitest",
	"plugins": [
		"@stryker-mutator/vitest-runner"
	],
	"vitest": {
		"configFile": "vitest.mutation.6700.config.ts",
		"related": false
	},
	"reporters": [
		"clear-text",
		"progress",
		"json"
	],
	"coverageAnalysis": "perTest",
	"incremental": true,
	"incrementalFile": "reports/mutation/stryker-incremental-6700.json",
	"concurrency": 4,
	"timeoutMS": 60000,
	"inPlace": true,
	"disableTypeChecks": false,
	"ignorePatterns": [
		"/dist",
		"/coverage",
		"/playwright-report",
		"/reports"
	],
	"mutate": [
		"src/pages/Common/MetricsView/workItemLookup.ts:6-16"
	],
	"thresholds": {
		"high": 90,
		"low": 80,
		"break": 80
	},
	"jsonReporter": {
		"fileName": "../docs/feature/bug-6700-chart-data-repeats-items/mutation/stryker-6700-frontend.json"
	},
	"tempDirName": ".stryker-tmp-6700"
}
