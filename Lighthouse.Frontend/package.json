{
	"name": "lighthouse.frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "cross-env VITE_API_BASE_URL=http://localhost:5169/api vite",
		"build": "pnpm exec tsc -b && vite build --outDir ../Lighthouse.Backend/Lighthouse.Backend/wwwroot",
		"build-docker": "pnpm exec tsc -b && vite build --outDir ./dist",
		"prebuild": "pnpm biome check --write ./src",
		"preview": "vite preview",
		"test": "cross-env TZ=Europe/Zurich vitest run --reporter=default",
		"sonarreport": "cross-env TZ=Europe/Zurich vitest run --coverage",
		"tauri": "tauri",
		"update-sidecar": "dotnet publish -c Release -r linux-x64 --self-contained -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o ../Lighthouse.Backend/Lighthouse.Backend/publish/linux-x64 ../Lighthouse.Backend/Lighthouse.Backend && mkdir -p src-tauri/binaries && mkdir -p src-tauri/resources && cp ../Lighthouse.Backend/Lighthouse.Backend/publish/linux-x64/Lighthouse src-tauri/binaries/Lighthouse.Backend-x86_64-unknown-linux-gnu && chmod +x src-tauri/binaries/Lighthouse.Backend-x86_64-unknown-linux-gnu && cp -r ../Lighthouse.Backend/Lighthouse.Backend/publish/linux-x64/. src-tauri/resources/ && rm -f src-tauri/resources/Lighthouse"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@melloware/react-logviewer": "^6.5.5",
		"@microsoft/signalr": "^10.0.11",
		"@mui/icons-material": "^7.3.11",
		"@mui/lab": "7.0.0",
		"@mui/material": "^9.3.1",
		"@mui/system": "^9.3.0",
		"@mui/x-charts": "9.0.1",
		"@mui/x-data-grid": "^9.12.0",
		"@mui/x-date-pickers": "9.0.0",
		"@tanstack/react-query": "^5.102.8",
		"@tauri-apps/api": "^2",
		"axios": "^1.20.0",
		"camelcase-keys": "^10.0.2",
		"date-fns": "^4.4.0",
		"dayjs": "^1.11.23",
		"lodash.debounce": "^4.0.8",
		"lorem-ipsum": "^3.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-markdown": "^10.1.0",
		"react-router": "^8.3.0",
		"remark-gfm": "^4.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/typescript-checker": "^9.6.1",
		"@stryker-mutator/vitest-runner": "^9.6.1",
		"@tauri-apps/cli": "^2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.6",
		"@types/date-fns": "^2.6.3",
		"@types/lodash.debounce": "^4.0.9",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.0",
		"@vitest/coverage-v8": "^4.1.0",
		"@vitest/spy": "4.1.11",
		"cross-env": "^10.1.0",
		"jsdom": "^30.0.1",
		"parse5": "^8.0.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.0",
		"vitest-sonar-reporter": "^3.0.0"
	}
}
