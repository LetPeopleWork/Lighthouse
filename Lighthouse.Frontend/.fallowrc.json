{
	"$schema": "./node_modules/fallow/schema.json",
	"boundaries": {
		"zones": [
			{ "name": "components", "patterns": ["src/components/**"] },
			{ "name": "context", "patterns": ["src/context/**"] },
			{ "name": "hooks", "patterns": ["src/hooks/**"] },
			{ "name": "models", "patterns": ["src/models/**"] },
			{ "name": "pages", "patterns": ["src/pages/**"] },
			{ "name": "services", "patterns": ["src/services/**"] },
			{ "name": "utils", "patterns": ["src/utils/**"] }
		],
		"rules": [
			{
				"from": "components",
				"allow": ["context", "hooks", "models", "services", "utils"]
			},
			{
				"from": "hooks",
				"allow": ["context", "models", "services", "utils"]
			},
			{
				"from": "services",
				"allow": ["components", "context", "models", "pages", "utils"]
			},
			{
				"from": "models",
				"allow": ["components", "context", "hooks", "services", "utils"]
			},
			{
				"from": "utils",
				"allow": ["components", "context", "hooks", "models", "pages"]
			}
		]
	}
}
