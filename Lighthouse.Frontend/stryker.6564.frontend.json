{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"packageManager": "pnpm",
	"testRunner": "vitest",
	"plugins": ["@stryker-mutator/vitest-runner"],
	"vitest": {
		"configFile": "vitest.mutation.6564.config.ts",
		"related": false
	},
	"reporters": ["clear-text", "progress", "json"],
	"coverageAnalysis": "perTest",
	"incremental": true,
	"incrementalFile": "reports/mutation/stryker-incremental-6564.json",
	"concurrency": 4,
	"timeoutMS": 60000,
	"inPlace": true,
	"disableTypeChecks": false,
	"ignorePatterns": ["/dist", "/coverage", "/playwright-report", "/reports"],
	"mutate": [
		"src/pages/Common/Reports/ReportNotes.tsx",
		"src/pages/Common/Reports/ReportNoteItem.tsx",
		"src/pages/Common/Reports/reportNoteByline.ts",
		"src/pages/Common/Reports/reportNoteRefusalCopy.ts",
		"src/pages/Common/Reports/useReportNotes.ts",
		"src/pages/Common/Reports/ReportView.tsx:87-89",
		"src/services/Api/ReportService.ts:180-232"
	],
	"thresholds": { "high": 90, "low": 80, "break": 0 },
	"jsonReporter": {
		"fileName": "../docs/feature/story-6564-report-notes/mutation/stryker-6564-frontend.json"
	},
	"tempDirName": ".stryker-tmp-6564"
}
