#!/usr/bin/env bash
# Runs the backend architecture rules and prints NUnit's per-test results.
# Usage: architecture-rules [name-fragment]
# With a name fragment, only the rule tests whose full name contains it run.
set -euo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
filter="FullyQualifiedName~Lighthouse.Backend.Tests.Architecture"
if [ $# -gt 0 ] && [ -n "$1" ]; then
  filter="${filter}&FullyQualifiedName~$1"
fi
exec dotnet test "$repo/Lighthouse.Backend/Lighthouse.Backend.Tests/Lighthouse.Backend.Tests.csproj" \
  --filter "$filter" --logger "console;verbosity=normal"
