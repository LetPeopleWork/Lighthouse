async Task<bool> ObserveTheTeamRefresh(TeamUnderTest team)
{
    var requestedAt = DateTime.UtcNow;
    await lighthouse.Send(HttpMethod.Post, $"/api/v1/teams/{team.Id}");
    await lighthouse.WaitUntilNothingIsUpdating();
    var row = (await lighthouse.TeamRefreshes(team.Id)).Where(at => at > requestedAt).Order().FirstOrDefault();
    var inProgress = await lighthouse.Count($"/api/v1/teams/{team.Id}/metrics/wip?asOfDate={DateTime.UtcNow:yyyy-MM-dd}");
    var blocked = await lighthouse.Count($"/api/v1/teams/{team.Id}/metrics/blockedItemsAtDate?date={DateTime.UtcNow:yyyy-MM-dd}");
    var what = $"Team {team.Id} \"{team.Name}\" refreshed at {Stamp(requestedAt)}";
    if (row == default)
    {
        report.Line($"Team refresh runs and is recorded in the refresh history: NOT OBSERVED. {what}; no Team row in the refresh history after it. " + Rerun);
        return false;
    }
    report.Line($"Team refresh runs and is recorded in the refresh history: OBSERVED. {what}; refresh history row at {Stamp(row)}; " +
        $"after it the Team answers {inProgress} Work Items in progress, {blocked} of them blocked");
    return true;
}

// Adding a field to the connection changes what its Teams download, which the connection save announces; the
// Work Items reaction to that announcement is the only thing that refreshes the Teams after the save.
async Task<bool> ObserveTheFetchShapeTrigger(TeamUnderTest team)
{
    var connection = await lighthouse.Get($"/api/v1/worktrackingsystemconnections/{team.ConnectionId}");
    connection["additionalFieldDefinitions"]!.AsArray().Add(new JsonObject
    {
        ["id"] = -1,
        ["displayName"] = "Refresh probe field",
        ["reference"] = "RefreshProbeField",
        ["isPredefined"] = false,
    });
    var savedAt = DateTime.UtcNow;
    await lighthouse.Send(HttpMethod.Put, $"/api/v1/worktrackingsystemconnections/{team.ConnectionId}", connection);
    var row = await lighthouse.TeamRefreshAfter(team.Id, savedAt);
    var what = $"a field was added to connection {team.ConnectionId} at {Stamp(savedAt)}";
    if (row is null)
    {
        report.Line($"changed download refreshes the connection's Teams: NOT OBSERVED. {what}; no refresh of Team {team.Id} followed. " + Rerun);
        return false;
    }
    report.Line($"changed download refreshes the connection's Teams: OBSERVED. {what}; Team {team.Id} refreshed at {Stamp(row.Value)}");
    return true;
}

async Task<bool> ObserveTheRefreshHistoryCleanup(TeamUnderTest team)
{
    var before = (await lighthouse.TeamRefreshes(team.Id)).Count;
    await lighthouse.Send(HttpMethod.Delete, $"/api/v1/teams/{team.Id}");
    var after = await lighthouse.TeamRefreshesOnceGone(team.Id);
    var what = $"Team {team.Id} had {before} rows in the refresh history and was deleted";
    if (before == 0 || after > 0)
    {
        report.Line($"deleted Team leaves the refresh history: NOT OBSERVED. {what}; {after} rows are left. " + Rerun);
        return false;
    }
    report.Line($"deleted Team leaves the refresh history: OBSERVED. {what}; none are left");
    return true;
}

