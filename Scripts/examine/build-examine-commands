async Task<List<(string Name, string Path, object? Body)>> RequestsForWhatIsLoaded()
{
    var owners = new[]
    {
        (Name: "team", Ids: await IdsOf("/api/v1/teams"), At: "/api/v1/teams"),
        (Name: "portfolio", Ids: await IdsOf("/api/v1/portfolios"), At: "/api/v1/portfolios"),
    };
    var requests = new List<(string Name, string Path, object? Body)>();
    foreach (var owner in owners)
    {
        foreach (var id in owner.Ids)
        {
            var at = $"{owner.At}/{id}";
            var name = $"{owner.Name}-{id}";
            requests.Add(($"{name}/in-progress-today", $"{at}/metrics/wip?asOfDate={Day(0)}", null));
            // A past day is answered from the stored blocked periods rather than from today's items.
            requests.Add(($"{name}/in-progress-a-week-ago", $"{at}/metrics/wip?asOfDate={Day(-7)}", null));
            requests.Add(($"{name}/finished", $"{at}/metrics/cycleTimeData?startDate={Day(-90)}&endDate={Day(0)}", null));
            requests.Add(($"{name}/blocked-today", $"{at}/metrics/blockedItemsAtDate?date={Day(0)}", null));
            requests.Add(($"{name}/blocked-a-week-ago", $"{at}/metrics/blockedItemsAtDate?date={Day(-7)}", null));
            requests.Add(($"{name}/blocked-count-history", $"{at}/metrics/blockedCountHistory?startDate={Day(-90)}&endDate={Day(0)}", null));
            requests.Add(($"{name}/feature-list", $"{at}/feature-list", null));
        }
    }
    foreach (var feature in await IdsOf("/api/v1/features"))
    {
        requests.Add(($"feature-{feature}/work-items", $"/api/v1/features/{feature}/workitems", null));
    }
    requests.Add(("features-with-dependencies", "/api/v1/features", null));
    return requests;
}

async Task<List<int>> IdsOf(string path) =>
    (await Get(path)).AsArray().Select(o => o!["id"]!.GetValue<int>()).Order().ToList();

// Refreshes each listed Team or Portfolio through its refresh button and waits until the updates have run;
// returns why a refresh was refused, or null.
async Task<string?> RefreshEach(string listPath, Func<int, string> refreshPath)
{
    foreach (var id in await IdsOf(listPath))
    {
        var answer = await client.PostAsync(refreshPath(id), null);
        if (!answer.IsSuccessStatusCode)
        {
            return $"POST {refreshPath(id)} answered {(int)answer.StatusCode}, so this revision's refresh cannot be compared";
        }
    }
    await WaitUntilNothingIsUpdating();
    return null;
}
EOF
