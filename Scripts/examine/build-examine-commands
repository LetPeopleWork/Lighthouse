#!/usr/bin/env bash
# Builds the commands nWave's examiner may run (declared in .nwave/examine.json).
# The examiner starts a command from a copy of its file descriptor, outside the checkout, so a command cannot
# find the repository from its own location; this step writes each command with the checkout's path built in.
set -euo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
out="$repo/Scripts/examine/bin"
home="$HOME"
mkdir -p "$out"
cat > "$out/architecture-rules" <<EOF
#!/usr/bin/env bash
# Runs the backend architecture rules and prints one line per test (Passed or Failed, with its name and case)
# plus the totals; a failing test also prints its message.
# Usage: architecture-rules [name-fragment [Debug|Release]]
#   name-fragment  runs only the rules whose full name contains it, for example FlowMetrics
#   Release        builds and runs the rules the way CI does (some code is compiled differently there)
set -euo pipefail
# The examiner runs commands in a bare environment; the .NET SDK and its local tools live under the user's home.
export HOME="$home" DOTNET_CLI_HOME="$home" DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
filter="FullyQualifiedName~Lighthouse.Backend.Tests.Architecture"
if [ \$# -gt 0 ] && [ -n "\$1" ]; then
  filter="\${filter}&FullyQualifiedName~\$1"
fi
configuration="\${2:-Debug}"
echo "configuration: \$configuration, filter: \$filter"
dotnet test "$repo/Lighthouse.Backend/Lighthouse.Backend.Tests/Lighthouse.Backend.Tests.csproj" -c "\$configuration" \\
  --filter "\$filter" --logger "console;verbosity=normal" 2>&1 \\
  | grep -E "^  (Passed|Failed) |^    (Error Message|  )|^Test Run|^Total tests|^ +(Passed|Failed|Skipped):|: error " || true
EOF
chmod +x "$out/architecture-rules"

cat > "$out/ef-model-unchanged" <<EOF
#!/usr/bin/env bash
# Asks EF Core, for both database providers, whether the code's data model differs from the last migration.
# Prints "No changes have been made to the model since the last migration." per provider when it does not.
set -euo pipefail
# The examiner runs commands in a bare environment; the .NET SDK and its local tools live under the user's home.
export HOME="$home" DOTNET_CLI_HOME="$home" DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
cd "$repo/Lighthouse.Backend"
dotnet build Lighthouse.Migrations.Sqlite >/dev/null
dotnet build Lighthouse.Migrations.Postgres >/dev/null
dotnet build Lighthouse.Backend >/dev/null
for provider in Sqlite Postgres; do
  echo "== \$provider"
  dotnet ef migrations has-pending-model-changes --no-build --project "Lighthouse.Migrations.\$provider" \\
    --startup-project Lighthouse.Backend --context LighthouseAppContext
done
EOF
chmod +x "$out/ef-model-unchanged"

cat > "$out/metrics-answers-compare" <<EOF
#!/usr/bin/env bash
# Captures every Flow metrics API answer on two git revisions, back to back on the same backup database,
# and compares them. Exit 0 and "identical" mean every answer and the snapshot tables match.
# Usage: metrics-answers-compare [base-revision [candidate-revision]]   (takes about 5 to 10 minutes)
# With no arguments it compares the last revision before the Flow metrics move (7ec328cb6) with the checkout's HEAD.
set -euo pipefail
# The examiner runs commands in a bare environment; the .NET SDK and its local tools live under the user's home.
export HOME="$home" DOTNET_CLI_HOME="$home" DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
base="\${1:-7ec328cb6}"
candidate="\${2:-\$(git -C "$repo" rev-parse HEAD)}"
echo "comparing base \$base with candidate \$candidate"
cap="$repo/docs/feature/story-6358-s02-metrics-pilot/capture"
work="\$(mktemp -d)"
"\$cap/capture-metrics.sh" "\$base" "\$work/base" >"\$work/base.log" 2>&1 || { tail -20 "\$work/base.log"; exit 1; }
"\$cap/capture-metrics.sh" "\$candidate" "\$work/candidate" >"\$work/candidate.log" 2>&1 || { tail -20 "\$work/candidate.log"; exit 1; }
echo "base manifest:"; cat "\$work/base/_manifest.txt"
echo "candidate manifest:"; cat "\$work/candidate/_manifest.txt"
"\$cap/compare.sh" "\$work/base" "\$work/candidate"
EOF
chmod +x "$out/metrics-answers-compare"

cat > "$out/backend-tests" <<EOF
#!/usr/bin/env bash
# Runs the whole backend test suite except the tests that talk to real Jira, Linear, Azure DevOps, ServiceNow
# and GitHub instances, and prints the totals plus the name of every failing test. Takes about 7 minutes.
# Usage: backend-tests [name-fragment]   (a fragment narrows the run to tests whose full name contains it,
# for example DomainEventHandlerOrderPin for the check that event handlers keep their order; a narrowed run
# also prints every passing test by name, so you can see which scenarios ran)
set -euo pipefail
# The examiner runs commands in a bare environment; the .NET SDK and its local tools live under the user's home.
export HOME="$home" DOTNET_CLI_HOME="$home" DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
filter="TestCategory!=JiraIntegration&TestCategory!=LinearIntegration&TestCategory!=AdoIntegration&TestCategory!=ServiceNowIntegration&TestCategory!=GithubIntegration"
lines="^Test Run|^Total tests|^ +(Passed|Failed|Skipped):|^  Failed |: error "
if [ \$# -gt 0 ] && [ -n "\$1" ]; then
  filter="\${filter}&FullyQualifiedName~\$1"
  lines="\${lines}|^  Passed "
fi
dotnet test "$repo/Lighthouse.Backend/Lighthouse.Backend.Tests/Lighthouse.Backend.Tests.csproj" --filter "\$filter" \\
  --logger "console;verbosity=normal" 2>&1 | grep -E "\$lines" || true
EOF
chmod +x "$out/backend-tests"

node_bin="$(dirname "$(command -v node)")"
cat > "$out/frontend-tests" <<EOF
#!/usr/bin/env bash
# Runs the frontend tests and prints every test by name with its result, plus the totals.
# Usage: frontend-tests [path-fragments [name-fragment]]
#   path-fragments  runs only the spec files whose path contains one of them; separate several with commas,
#                   for example Settings/Rbac or MetricsView/ragRules,Connection/,useScopedAccess
#   name-fragment   runs only the tests whose name contains it, for example "No direct role"
# Result marks: ✓ passed, × failed, ↓ skipped. With a name fragment, every test whose name lacks it is
# reported as skipped: it did not run, and it did not fail. Run without a name fragment to see a whole file.
# Rows that check a message a user reads name that exact text in quotes, so a passing row shows the text.
set -euo pipefail
if [ "\${1:-}" = "--help" ] || [ "\${1:-}" = "-h" ]; then
  sed -n '2,/^set -euo/p' "\$0" | grep '^#' | sed 's/^# \{0,1\}//'
  exit 0
fi
# The examiner runs commands in a bare environment; Node and pnpm live under the user's home.
export HOME="$home" PATH="$node_bin:/usr/bin:/bin" CI=true NO_COLOR=1 FORCE_COLOR=0
cd "$repo/Lighthouse.Frontend"
args=(run --reporter=verbose)
if [ \$# -gt 0 ] && [ -n "\$1" ]; then IFS=, read -r -a paths <<< "\$1"; args+=("\${paths[@]}"); fi
if [ \$# -gt 1 ] && [ -n "\$2" ]; then args+=(-t "\$2"); fi
pnpm exec vitest "\${args[@]}" 2>&1 | grep -E "^ +(✓|×|↓) |^ +(Test Files|Tests) |FAIL " || true
EOF
chmod +x "$out/frontend-tests"

cat > "$out/feature-proof" <<EOF
#!/usr/bin/env bash
# Shows the proof a test-only feature keeps in its evidence folder, docs/feature/<feature>/evidence/:
# the id oracles (s<N>_compare_ids.py), the id tables (s<N>-id-table.md) and the deliberate breaks (s<N>_breaks.py).
# Usage: feature-proof <feature> <action> [arguments]
#   list               names the oracles, id tables and break scripts the feature has
#   oracles            runs every id oracle; per slice prints its EXTRA/MISSING/GUARD/CHANGED lines, its last line and its exit code
#                      (exit 0 = the observed test ids equal the expected ones and no guarded file changed)
#   table <N>          prints slice N's id table: each removed host test, what it walked, the test that now proves it,
#                      the break and the rows that went red
#   breaks <N>         lists slice N's deliberate breaks (id and what each breaks)
#   break <N> <id>...  applies each named break to the production line, runs the named tests, prints which went red, and
#                      puts the line back (a break proves its rule only if at least one row goes red)
#   summary <base>     everything in one call (about 3 minutes): diff, every oracle, and the first break of each
#                      slice with the rows it turns red
#   diff <base>        lists files changed since <base> under the production project, in the host-user guard list and in
#                      the test time budget, with the guard list's added and removed lines
# Example: feature-proof story-6537-a-percentiles-suite oracles
set -euo pipefail
if [ "\${1:-}" = "--help" ] || [ "\${1:-}" = "-h" ] || [ \$# -lt 2 ]; then
  sed -n '2,/^set -euo/p' "\$0" | grep '^#' | sed 's/^# \{0,1\}//'
  exit 0
fi
# The examiner runs commands in a bare environment; the .NET SDK lives under the user's home.
export HOME="$home" DOTNET_CLI_HOME="$home" DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
feature="\$1"; action="\$2"; shift 2
case "\$feature" in */*|.*) echo "feature must be a folder name under docs/feature"; exit 2;; esac
ev="$repo/docs/feature/\$feature/evidence"
[ -d "\$ev" ] || { echo "no evidence folder for \$feature"; exit 2; }
cd "$repo"
case "\$action" in
  list) ls "\$ev" | grep -E '^s[0-9]+(_compare_ids\.py|-id-table\.md|_breaks\.py)\$' ;;
  oracles)
    for o in \$(ls "\$ev" | grep -E '^s[0-9]+_compare_ids\.py\$' | sort -V); do
      set +e; out="\$(python3 "\$ev/\$o" 2>&1)"; code=\$?; set -e
      echo "== \$o (exit \$code)"
      printf '%s\n' "\$out" | grep -E '^(EXTRA|MISSING|GUARD|CHANGED|OUTCOME)' || true
      printf '%s\n' "\$out" | tail -1
    done ;;
  table) cat "\$ev/s\${1:?slice number}-id-table.md" ;;
  breaks) grep -oE '^\s+\("[A-Z][A-Za-z0-9]* [^"]*"' "\$ev/s\${1:?slice number}_breaks.py" | sed -E 's/^\s+\("//; s/"\$//' ;;
  break) n="\${1:?slice number}"; shift; python3 "\$ev/s\${n}_breaks.py" "\$@" 2>&1 ;;
  diff)
    base="\${1:?base revision}"
    echo "production files changed: \$(git diff --name-only "\$base" HEAD -- Lighthouse.Backend/Lighthouse.Backend/ | wc -l)"
    git diff --name-only "\$base" HEAD -- Lighthouse.Backend/Lighthouse.Backend/ | sed 's/^/  /'
    echo "time budget files changed: \$(git diff --name-only "\$base" HEAD -- Scripts/test-timings/test-time-budget.json | wc -l)"
    echo "host-user guard list, lines added and removed:"
    git diff "\$base" HEAD -- Lighthouse.Backend/Lighthouse.Backend.Tests/Architecture/TestHostUseGuardTest.HostUsersStillToMove.cs \\
      | grep -E '^[+-][^+-]' | sed 's/^/  /' || echo "  none" ;;
  summary)
    base="\${1:?base revision}"
    echo "##### diff since \$base"; "\$0" "\$feature" diff "\$base"
    echo "##### oracles"; "\$0" "\$feature" oracles
    for b in \$(ls "\$ev" | grep -E '^s[0-9]+_breaks\.py\$' | sort -V); do
      n="\${b#s}"; n="\${n%%_*}"
      first="\$("\$0" "\$feature" breaks "\$n" | head -1 | cut -d' ' -f1)"
      echo "##### slice \$n, break \$first"; "\$0" "\$feature" break "\$n" "\$first" | grep -E '^(===|Failed |Passed!|Failed!|NO SUMMARY|SKIPPED)' || true
    done ;;
  *) echo "unknown action \$action (try --help)"; exit 2 ;;
esac
EOF
chmod +x "$out/feature-proof"
