public sealed class Instance : IAsyncDisposable
{
    private WebApplicationFactory<Lighthouse.Backend.Program>? factory;
    private HttpClient? client;

    private HttpClient Client => client ?? throw new InvalidOperationException("the backend was not started");

    public async Task Start()
    {
        factory = new WebApplicationFactory<Lighthouse.Backend.Program>();
        client = factory.CreateClient();
        client.Timeout = TimeSpan.FromMinutes(2);
        await Get("/api/v1/update/status");
    }

    public async Task ImportLicence(string? licence, Report report)
    {
        if (licence is null)
        {
            report.Line("licence: none, which the smallest demo scenario does not need");
            return;
        }
        using var form = new MultipartFormDataContent();
        form.Add(new ByteArrayContent(await File.ReadAllBytesAsync(licence)), "file", "licence.json");
        var imported = await Client.PostAsync("/api/v1/license/import", form);
        report.Line($"licence: premium licence imported ({(int)imported.StatusCode})");
    }

    public async Task<(int Id, string Title)> SmallestScenarioWithTeams()
    {
        var chosen = (await Get("/api/v1/demo/scenarios")).AsArray()
            .Select(s => s!)
            .Where(s => s["teams"]!.AsArray().Count > 0)
            .OrderBy(s => s["teams"]!.AsArray().Count + s["projects"]!.AsArray().Count)
            .ThenBy(s => s["id"]!.GetValue<int>())
            .FirstOrDefault()
            ?? throw new InvalidOperationException("no demo scenario has Teams; the demo data files may be missing");
        return (chosen["id"]!.GetValue<int>(), chosen["title"]!.GetValue<string>());
    }

    public async Task LoadScenario(int id)
    {
        await Send(HttpMethod.Post, $"/api/v1/demo/scenarios/{id}/load");
        await WaitUntilNothingIsUpdating();
    }

    public async Task<TeamUnderTest> FirstTeam()
    {
        var id = (await Get("/api/v1/teams")).AsArray().Select(t => t!["id"]!.GetValue<int>()).Min();
        var settings = await Get($"/api/v1/teams/{id}/settings");
        return new TeamUnderTest(id, settings["name"]!.GetValue<string>(), settings["workTrackingSystemConnectionId"]!.GetValue<int>());
    }

    public async Task Send(HttpMethod method, string path, JsonNode? body = null)
    {
        using var request = new HttpRequestMessage(method, path);
        if (body is not null)
        {
            request.Content = new StringContent(body.ToJsonString(), System.Text.Encoding.UTF8, "application/json");
        }
        var answer = await Client.SendAsync(request);
        if (!answer.IsSuccessStatusCode)
        {
            throw new InvalidOperationException($"{method} {path} answered {(int)answer.StatusCode} {await answer.Content.ReadAsStringAsync()}");
        }
    }

    public async Task<int> Count(string path) => (await Get(path)).AsArray().Count;

    /// <summary>When the refresh history says the Team was refreshed.</summary>
    public async Task<List<DateTime>> TeamRefreshes(int teamId) =>
        [.. (await Get("/api/v1/systeminfo/refreshlog")).AsArray()
            .Select(r => r!)
            .Where(r => IsTeamRefresh(r["type"]!) && r["entityId"]!.GetValue<int>() == teamId)
            .Select(r => DateTime.Parse(r["executedAt"]!.GetValue<string>(), CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal))];

    /// <summary>The first refresh of the Team after an instant, waiting a short while for it to be queued.</summary>
    public async Task<DateTime?> TeamRefreshAfter(int teamId, DateTime since)
    {
        for (var i = 0; i < 20; i++)
        {
            await WaitUntilNothingIsUpdating();
            var after = (await TeamRefreshes(teamId)).Where(at => at > since).Order().ToList();
            if (after.Count > 0)
            {
                return after[0];
            }
            await Task.Delay(1000);
        }
        return null;
    }

    /// <summary>How many refresh history rows of the Team are left once the clean-up had a short while to run.</summary>
    public async Task<int> TeamRefreshesOnceGone(int teamId)
    {
        var left = (await TeamRefreshes(teamId)).Count;
        for (var i = 0; i < 20 && left > 0; i++)
        {
            await Task.Delay(1000);
            left = (await TeamRefreshes(teamId)).Count;
        }
        return left;
    }

    public async Task WaitUntilNothingIsUpdating()
    {
        var quiet = 0;
        for (var i = 0; i < 600 && quiet < 3; i++)
        {
            await Task.Delay(300);
            var status = await Get("/api/v1/update/status");
            quiet = status["hasActiveUpdates"]!.GetValue<bool>() ? 0 : quiet + 1;
        }
        if (quiet < 3)
        {
            throw new TimeoutException("updates were still running after 3 minutes");
        }
    }

    public async Task<JsonNode> Get(string path) =>
        JsonNode.Parse(await Client.GetStringAsync(path)) ?? throw new InvalidOperationException($"empty answer from {path}");

    public async ValueTask DisposeAsync()
    {
        client?.Dispose();
        client = null;
        if (factory is not null)
        {
            await factory.DisposeAsync();
            factory = null;
        }
    }

    private static bool IsTeamRefresh(JsonNode type) =>
        type.GetValueKind() == System.Text.Json.JsonValueKind.String
            ? type.GetValue<string>() == "Team"
            : type.GetValue<int>() == (int)Lighthouse.Backend.Models.RefreshType.Team;
}
